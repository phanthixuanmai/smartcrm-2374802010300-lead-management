# MySQL database (use "localhost" for a local MySQL server; Compose uses "db")
DB_HOST=db
DB_PORT=3306
DB_NAME=smartcrm
DB_USER=smartcrm_app
DB_PASSWORD=change_this_database_password
DB_ROOT_PASSWORD=change_this_root_password
DB_CREATE_DATABASE=false

# App
APP_PORT=3000
FRONTEND_PORT=5173
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SmartCRM login (set a unique password before deployment)
AUTH_USERNAME=admin
AUTH_PASSWORD=change_this_auth_password